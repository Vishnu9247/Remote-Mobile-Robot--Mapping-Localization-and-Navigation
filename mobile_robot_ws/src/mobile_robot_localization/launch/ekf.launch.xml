<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="odom_topic" default="/wheel/odom"/>
  <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
    <param from="$(find-pkg-share mobile_robot_localization)/config/ekf.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="odom0" value="$(var odom_topic)"/>
    <remap from="odometry/filtered" to="/odom"/>
  </node>
</launch>
