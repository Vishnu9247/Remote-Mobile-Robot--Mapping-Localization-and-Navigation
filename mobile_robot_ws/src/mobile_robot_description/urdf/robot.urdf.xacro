<?xml version="1.0"?>
<robot name="mobile_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="simulation" default="false"/>
  <!-- CAD: SI units; X forward, Y left, Z up; base origin at ground centre. -->
  <xacro:property name="radius" value="0.060"/>
  <xacro:property name="half_track" value="0.123"/>
  <xacro:property name="half_wheelbase" value="0.095"/>
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial><mass value="${mass}"/><inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/></inertial>
  </xacro:macro>
  <xacro:macro name="mesh" params="part xyz rpy color">
    <visual><origin xyz="${xyz}" rpy="${rpy}"/><geometry><mesh filename="package://mobile_robot_description/meshes/${part}.stl"/></geometry><material name="${part}"><color rgba="${color}"/></material></visual>
  </xacro:macro>
  <!-- 3 kg total is an assumed CAD design target, not a measured mass. -->
  <link name="base_link">
    <inertial><origin xyz="0 0 0.085"/><mass value="2.35"/><inertia ixx="0.010" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.026"/></inertial>
    <xacro:mesh part="P01_deck_front" xyz="0.075075 0 0.093" rpy="0 0 0" color="0.13 0.28 0.38 1"/>
    <xacro:mesh part="P02_deck_rear" xyz="-0.075075 0 0.093" rpy="0 0 0" color="0.13 0.28 0.38 1"/>
    <xacro:mesh part="P10_sensor_platform" xyz="0 0 0.1445" rpy="0 0 0" color="0.13 0.28 0.38 1"/>
    <collision><origin xyz="0 0 0.093"/><geometry><box size="0.300 0.200 0.014"/></geometry></collision>
    <collision><origin xyz="0 0 0.1445"/><geometry><box size="0.120 0.100 0.005"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <inertial><mass value="0.12"/><inertia ixx="0.0001104" ixy="0" ixz="0" iyy="0.000216" iyz="0" izz="0.0001104"/></inertial>
      <xacro:mesh part="P08_wheel_rim" xyz="0 0 0" rpy="${pi/2} 0 0" color="0.25 0.45 0.55 1"/>
      <xacro:mesh part="P09_TPU_tyre" xyz="0 0 0" rpy="${pi/2} 0 0" color="0.10 0.10 0.10 1"/>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="0.020"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_link"/><origin xyz="${x} ${y} ${radius}"/><axis xyz="0 1 0"/>
      <limit effort="1.5" velocity="5.0"/><dynamics damping="0.01" friction="0.0"/>
    </joint>
    <!-- Low contact friction is an initial simulation tuning for skid steering. -->
    <gazebo reference="${name}_link"><mu1>0.6</mu1><mu2>0.6</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel name="front_left_wheel" x="${half_wheelbase}" y="${half_track}"/>
  <xacro:wheel name="rear_left_wheel" x="${-half_wheelbase}" y="${half_track}"/>
  <xacro:wheel name="front_right_wheel" x="${half_wheelbase}" y="${-half_track}"/>
  <xacro:wheel name="rear_right_wheel" x="${-half_wheelbase}" y="${-half_track}"/>
  <xacro:macro name="sensor_link" params="name xyz x y z mass">
    <link name="${name}"><xacro:box_inertia mass="${mass}" x="${x}" y="${y}" z="${z}"/>
      <visual><geometry><box size="${x} ${y} ${z}"/></geometry><material name="sensor_black"><color rgba="0.15 0.15 0.15 1"/></material></visual>
      <collision><geometry><box size="${x} ${y} ${z}"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${xyz}"/></joint>
  </xacro:macro>
  <xacro:sensor_link name="lidar_link" xyz="0 0 0.185" x="0.05" y="0.05" z="0.04" mass="0.10"/>
  <xacro:sensor_link name="camera_link" xyz="0.065 0 0.17" x="0.025" y="0.05" z="0.025" mass="0.05"/>
  <xacro:sensor_link name="imu_link" xyz="0 0 0.105" x="0.02" y="0.02" z="0.01" mass="0.02"/>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <xacro:if value="$(arg simulation)">
    <ros2_control name="GazeboSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:macro name="wheel_interface" params="name">
        <joint name="${name}_joint"><command_interface name="velocity"><param name="min">-5.0</param><param name="max">5.0</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
      </xacro:macro>
      <xacro:wheel_interface name="front_left_wheel"/><xacro:wheel_interface name="rear_left_wheel"/>
      <xacro:wheel_interface name="front_right_wheel"/><xacro:wheel_interface name="rear_right_wheel"/>
    </ros2_control>
    <gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(find mobile_robot_control)/config/controllers.yaml</parameters></plugin></gazebo>
    <!-- Preserve sensor link names and joints when URDF is reduced to SDF. -->
    <gazebo reference="lidar_link_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="camera_link_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="imu_link_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="lidar_link"><sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan><range><min>0.08</min><max>10.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></lidar>
    </sensor></gazebo>
    <gazebo reference="imu_link"><sensor name="imu" type="imu"><topic>/imu/data</topic><gz_frame_id>imu_link</gz_frame_id><update_rate>100</update_rate><always_on>true</always_on><imu><angular_velocity><z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z></angular_velocity></imu></sensor></gazebo>
    <gazebo reference="camera_link"><sensor name="camera" type="camera"><topic>/camera/image</topic><gz_frame_id>camera_optical_frame</gz_frame_id><update_rate>15</update_rate><always_on>true</always_on><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.02</near><far>15</far></clip></camera></sensor></gazebo>
  </xacro:if>
</robot>
